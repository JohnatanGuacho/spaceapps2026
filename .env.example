# 1. archivos de entorno
Set-Content .env.example @'
DATASET_DIR=../dataset_clean
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
'@
Set-Content .env @'
DATASET_DIR=../dataset_clean
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
'@

# 2. parches de kernel, registro y tests
@'
from pathlib import Path

k = Path("app/engine/kernel.py")
t = k.read_text(encoding="utf-8")
t = t.replace(
    'def quench_limit(material: str | None, env: Environment) -> float:\n'
    '    base = MATERIAL_LOI.get(material or "", DEFAULT_LOI)\n'
    '    value = base\n'
    '    if env.gravity_g < 0.1:\n'
    '        value += 0.028\n',
    'FORCED_MODES = {"concurrent", "coflow"}\n\n\n'
    'def quench_limit(material: str | None, env: Environment, mode: str = "opposed") -> float:\n'
    '    """Límite de O2 para sostener llama. La convección forzada lo baja."""\n'
    '    base = MATERIAL_LOI.get(material or "", DEFAULT_LOI)\n'
    '    value = base\n'
    '    if mode in FORCED_MODES:\n'
    '        value -= 0.025\n'
    '    elif env.gravity_g < 0.1:\n'
    '        value += 0.028\n',
)
t = t.replace("    limit = quench_limit(material, env)", "    limit = quench_limit(material, env, mode)")
k.write_text(t, encoding="utf-8")

r = Path("app/ingest/registry.py")
s = r.read_text(encoding="utf-8")
s = s.replace('r"cfi(?!-?g)"', 'r"cfi(?![-_ ]?g)"')
s = s.replace(
    'def match_column(schema: Schema, header: str) -> Col | None:\n'
    '    key = norm_header(header)\n'
    '    if key in schema.columns:\n'
    '        return schema.columns[key]\n'
    '    for name, col in schema.columns.items():\n'
    '        if name in key or key in name:\n'
    '            return col\n'
    '    return None\n',
    'def match_column(schema: Schema, header: str) -> Col | None:\n'
    '    key = norm_header(header)\n'
    '    for name, col in schema.columns.items():\n'
    '        if norm_header(name) == key:\n'
    '            return col\n'
    '    for name, col in schema.columns.items():\n'
    '        norm = norm_header(name)\n'
    '        if norm in key or key in norm:\n'
    '            return col\n'
    '    return None\n',
)
r.write_text(s, encoding="utf-8")

t2 = Path("tests/test_kernel.py")
u = t2.read_text(encoding="utf-8")
if "from dataclasses import replace" not in u:
    u = u.replace("import pytest", "from dataclasses import replace\n\nimport pytest", 1)
u = u.replace(
    'def test_quench_en_atmosfera_pobre():\n'
    '    assert kernel.burn_rate("PMMA", ENVIRONMENTS["iss"] | {}, "opposed")  # sanity\n',
    'def test_quench_en_atmosfera_pobre():\n'
    '    env = replace(ENVIRONMENTS["iss"], o2_fraction=0.15)\n'
    '    assert kernel.burn_rate("PMMA", env, "opposed")["quenched"] is True\n',
)
u = u.replace(
    '    assert kernel.quench_limit("PMMA", ENVIRONMENTS["eva"]) > kernel.quench_limit("PMMA", ENVIRONMENTS["mars"])\n',
    '    assert kernel.quench_limit("PMMA", ENVIRONMENTS["eva"]) > kernel.quench_limit("PMMA", ENVIRONMENTS["mars"])\n\n\n'
    'def test_conveccion_forzada_baja_el_limite():\n'
    '    env = ENVIRONMENTS["iss"]\n'
    '    assert kernel.quench_limit("SIBAL", env, "concurrent") < kernel.quench_limit("SIBAL", env, "opposed")\n',
)
t2.write_text(u, encoding="utf-8")
print("parcheado")
'@ | python -

# 3. verificar
pytest -q
